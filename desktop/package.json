{
  "name": "attendance-desktop",
  "version": "1.0.0",
  "description": "Face Recognition Attendance System — Desktop Application",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "compile": "tsc && vite build",
    "build": "tsc && vite build && electron-builder --config electron-builder.config.js",
    "build:unpack": "tsc && vite build && electron-builder --dir --config electron-builder.config.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "rebuild-sqlite": "electron-rebuild -f -w better-sqlite3",
    "copy-models": "node scripts/copy-face-models.js",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.30.10",
    "electron-updater": "^6.1.8",
    "exceljs": "^4.4.0",
    "googleapis": "^178.0.0",
    "i18next": "^23.11.5",
    "lucide-react": "^0.379.0",
    "node-cron": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "react-router-dom": "^6.23.1",
    "tailwind-merge": "^2.3.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.21.4",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
