# Environment variables for docker-compose
# Copy this file to .env and fill in real values before deploying.
# DO NOT commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=attendance
DB_USER=teli
DB_PASS=CHANGE_ME_STRONG_PASSWORD_HERE

# ─── Ports ────────────────────────────────────────────────────────────────────
API_PORT=8086      # Spring Boot API
PWA_PORT=80        # Teacher PWA (Nginx)

# ─── Optional: Spring Boot extra config ───────────────────────────────────────
# SERVER_PORT=8086
